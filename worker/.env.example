# Sideline ingest worker (VPS / Node) environment.
# Copy to .env and fill in. NEVER commit real values.

# --- HiDrive WebDAV (classic HiDrive read access) ---------------------------------------
# Base URL INCLUDING your user root, trailing slash recommended.
#   IONOS:  https://webdav.hidrive.ionos.com/users/<loginname>/
#   Strato: https://webdav.hidrive.strato.com/users/<loginname>/
# hidrive_original_path values are stored RELATIVE to this base (e.g. "ingest/NGU_0001.jpg").
# WebDAV must be enabled in HiDrive settings -> access rights & protocols.
HIDRIVE_WEBDAV_URL=https://webdav.hidrive.ionos.com/users/<loginname>/
HIDRIVE_WEBDAV_USER=
HIDRIVE_WEBDAV_PASS=

# --- Supabase (service role — VPS only, bypasses RLS) -----------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Branding used in the watermark text ------------------------------------------------
BRAND=SIDELINE STUDIO

# --- Poller ------------------------------------------------------------------------------
# Folder (relative to HIDRIVE_WEBDAV_URL) scanned for new masters.
HIDRIVE_INGEST_FOLDER=ingest/
# Shared secret required by the optional HTTP trigger (Make.com). Leave blank to disable serve.
INGEST_TRIGGER_SECRET=
# Port for the HTTP trigger server (default 8787).
PORT=8787
