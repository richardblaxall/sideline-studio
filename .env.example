# App (Cloudflare Workers runtime) environment — documentation only.
# Real values are injected as Lovable Cloud secrets, NOT committed here.
# The ingest worker has its OWN separate env — see worker/.env.example and SECRETS.md.

# --- Supabase (managed by Lovable Cloud) ------------------------------------------------
# Server functions use the service role via src/integrations/supabase/client.server.ts.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Browser build-time (public) values:
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- HiDrive REST (OAuth2) — powers downloadOriginal sharelinks -------------------------
# From https://developer.hidrive.com. Only this half depends on the REST credential; ingest
# (the VPS worker) ships and is testable without these.
HIDRIVE_CLIENT_ID=
HIDRIVE_CLIENT_SECRET=
HIDRIVE_REFRESH_TOKEN=

# Absolute HiDrive path prefix for the account's user root, e.g. /users/<loginname>
# (hidrive_original_path is stored relative to the WebDAV base; the REST client prepends this
# prefix to form the absolute HiDrive path used for sharelinks/zip).
HIDRIVE_REST_PATH_PREFIX=/users/<loginname>

# Optional: where server-side ZIP archives are written before sharing.
# Defaults to <HIDRIVE_REST_PATH_PREFIX>/.sideline-archives
# HIDRIVE_ARCHIVE_DIR=/users/<loginname>/.sideline-archives
